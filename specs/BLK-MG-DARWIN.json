{
  "block_id": "BLK-MG-DARWIN",
  "description": "Morphogenesis: PRD Darwin fitness evaluation loop (darwin_loop.py)",
  "workspace": ".",
  "read_only_paths": [],
  "shell_allowlist": [
    "python3",
    "git",
    "pip",
    "echo",
    "base64",
    "grep",
    "wc",
    "cat",
    "touch"
  ],
  "directives": [
    {
      "id": "check_token",
      "type": "shell_execute",
      "description": "Verify GitHub token is available",
      "command": "echo ${GITHUB_TOKEN:0:4}",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "cleanup_workspace",
      "type": "shell_execute",
      "description": "Remove any prior clone",
      "command": "rm -rf /tmp/mg-darwin-work",
      "result_is_string": true,
      "on_failure": "continue"
    },
    {
      "id": "clone_repo",
      "type": "shell_execute",
      "description": "Clone Morphogenesis repo",
      "command": "git clone https://${GITHUB_TOKEN}@github.com/greatnorthernfishguy-hub/Morphogenesis.git /tmp/mg-darwin-work 2>&1 && echo OK",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "install_deps",
      "type": "shell_execute",
      "description": "Install dependencies",
      "command": "cd /tmp/mg-darwin-work && pip install -q -e . 2>&1 | tail -3 && echo DEPS_OK",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "verify_evolution_anchor",
      "type": "shell_execute",
      "description": "Confirm evolution.py anchor symbols exist",
      "command": "cd /tmp/mg-darwin-work && python3 -c \"from morphogenesis.evolution import run_generation, next_generation, random_config, evaluate_organism_full, EvolutionConfig; print(\"evolution anchors OK\")\"",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "verify_seed_anchor",
      "type": "shell_execute",
      "description": "Confirm seed.py anchor symbols exist",
      "command": "cd /tmp/mg-darwin-work && python3 -c \"from morphogenesis.seed import OrganismSeed, GrowthContext, ComprehensionRecord, ConstitutionalConstraint, FitnessExample, ScopeKind; print(\"seed anchors OK\")\"",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "write_darwin_loop",
      "type": "shell_execute",
      "description": "Write darwin_loop.py from base64",
      "command": "echo '' | base64 -d > /tmp/mg-darwin-work/morphogenesis/darwin_loop.py && echo WRITTEN",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "verify_darwin_loop_written",
      "type": "shell_execute",
      "description": "Verify darwin_loop.py imports cleanly",
      "command": "cd /tmp/mg-darwin-work && python3 -c \"from morphogenesis.darwin_loop import run_growth_campaign, GrowthCampaignResult, GenerationRecord; print(\"darwin_loop imports OK\")\"",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "write_test_darwin_loop",
      "type": "shell_execute",
      "description": "Write test_darwin_loop.py from base64",
      "command": "echo '' | base64 -d > /tmp/mg-darwin-work/morphogenesis/tests/test_darwin_loop.py && echo WRITTEN",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "verify_test_written",
      "type": "shell_execute",
      "description": "Confirm 14 test functions present",
      "command": "grep -c \"^def test_\" /tmp/mg-darwin-work/morphogenesis/tests/test_darwin_loop.py",
      "result_is_string": true,
      "expected_stdout": "14",
      "on_failure": "abort"
    },
    {
      "id": "compile_check",
      "type": "shell_execute",
      "description": "Syntax check darwin_loop.py",
      "command": "python3 -m py_compile /tmp/mg-darwin-work/morphogenesis/darwin_loop.py && echo SYNTAX_OK",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "run_new_tests",
      "type": "shell_execute",
      "description": "Run darwin_loop tests (14 expected)",
      "command": "cd /tmp/mg-darwin-work && python3 -m pytest morphogenesis/tests/test_darwin_loop.py -v 2>&1",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "run_full_suite",
      "type": "shell_execute",
      "description": "Run full test suite (450+ expected)",
      "command": "cd /tmp/mg-darwin-work && python3 -m pytest morphogenesis/tests/ -q 2>&1 | tail -5",
      "result_is_string": true,
      "on_failure": "abort"
    },
    {
      "id": "commit_and_push",
      "type": "shell_execute",
      "description": "Commit and push darwin_loop.py + test",
      "command": "cd /tmp/mg-darwin-work && git config user.email \"codemine@et-systems.local\" && git config user.name \"Codemine\" && git add morphogenesis/darwin_loop.py morphogenesis/tests/test_darwin_loop.py && git commit -m \"feat: PRD Darwin fitness evaluation loop (darwin_loop.py) +14 tests\" && git push 2>&1 && echo PUSH_OK",
      "result_is_string": true,
      "on_failure": "abort"
    }
  ]
}
